node_modules
dist

# Local environment — the real Firebase config.
# Only .env.example and .env.offline belong in the repo; .env.offline holds
# nothing but blank keys, which is the point of it.
.env
.env.*
!.env.example
!.env.offline

# Build caches
*.tsbuildinfo
.vite
coverage

# Firebase CLI upload cache — a hash of every file in dist/, rewritten on every
# deploy and meaningful only on the machine that produced it. dist/ is ignored,
# so a cache of dist/ has no business being tracked either.
.firebase/

.DS_Store
Thumbs.db
*.log
