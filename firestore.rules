rules_version = '2';

// Paste these into Firebase console -> Firestore Database -> Rules, or deploy
// with `firebase deploy --only firestore:rules`.
//
// This file is the actual security boundary. Nothing in the browser bundle may
// be depended on: anything shipped to a client can be edited by whoever is
// holding it.
//
// Without these rules, Firestore's default test rules expire after 30 days and
// leave the database open to the entire internet until they do.
service cloud.firestore {
  match /databases/{database}/documents {

    // Sign-up is open — anyone with a Google account, or an email/password
    // account they have confirmed, gets their own private tree under their uid.
    //
    // `email_verified` does the work the old address allowlist used to do.
    // Google always reports a verified address; an email/password account stays
    // unverified until the confirmation link is clicked, so a throwaway address
    // cannot write anything. Anonymous accounts carry no email at all, so
    // `email is string` refuses them — an unauthenticated visitor must not be
    // able to mint an identity and start writing. Keep the Anonymous provider
    // disabled in the console as well.
    //
    // `email_verified` is a claim baked into the ID token, so the app must
    // force getIdToken(true) after the link is clicked. Without that the user
    // sits on a stale `false` and every write is refused for up to an hour.
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // The whole of multi-user isolation is this line: a signed-in account can
    // only ever reach documents under its own uid.
    function ownsAccount(userId) {
      return verifiedUser() && request.auth.uid == userId;
    }

    // The documents the app actually writes. Anything else is refused, so a
    // tampered client cannot repurpose the database as free general-purpose
    // storage under its own uid.
    //
    // Adding a slice here and deploying is a PREREQUISITE for shipping the
    // bundle that writes it — reversed, the live app writes to a slice the
    // rules refuse and users see `permission-denied`.
    function isKnownSlice(sliceId) {
      return sliceId in ['settings', 'weights', 'meals', 'workouts', 'days', 'sessions'];
    }

    // Every slice document is exactly `{ value: <list|map> }`. Rejecting extra
    // top-level keys keeps a stray write from smuggling in fields the app will
    // later read back and trust.
    function wellFormed() {
      return request.resource.data.keys().hasOnly(['value'])
        && (request.resource.data.value is list || request.resource.data.value is map);
    }

    match /users/{userId}/slices/{sliceId} {
      // Read is deliberately NOT narrowed by sliceId. Firestore evaluates a
      // collection query against the rule rather than against the documents it
      // returns, so requiring a known id here would reject the app's own
      // `getDocs(slices)` listing outright. Nothing unknown can exist to be
      // read anyway, because create/update below refuse to make it.
      allow read: if ownsAccount(userId);

      allow create, update: if ownsAccount(userId)
        && isKnownSlice(sliceId)
        && wellFormed();

      allow delete: if ownsAccount(userId);
    }

    // Everything else. Firestore already denies by default; stating it means a
    // future `match` added above this one has to be a deliberate act.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
