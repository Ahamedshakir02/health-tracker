# ---------------------------------------------------------------------------
# Local-only mode — loaded by `npm run dev:local` (vite --mode offline).
#
# Vite loads .env first and then .env.offline, so the blank values below
# override your real config for this one command. Nothing here is a secret and
# this file IS committed, so `npm run dev:local` works on a fresh clone.
#
# The app sees no Firebase config, skips sign-in, and keeps everything in
# localStorage as JSON. Use it for UI work: no Firestore reads or writes, no
# risk to real data, and no sign-in round trip on every reload.
#
# Your real `.env` is untouched — `npm run dev` still runs the signed-in app.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
