{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
          },
          {
            "comment": "Default everything to revalidate. cleanUrls means the SPA shell is served at '/', which an /index.html rule never matches — without this it inherits Firebase's 1h default and a phone keeps running the previous deploy. The hashed-asset rules below override this.",
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "comment": "Exercise animation frames are content-hash named, so they can be cached forever. Regenerating a clip changes its filename, so a stale copy is never served.",
        "source": "/exercise-anim/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
