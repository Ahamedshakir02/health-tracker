# ---------------------------------------------------------------------------
# Firebase sync (optional)
# ---------------------------------------------------------------------------
# The app works fully offline with local JSON storage. Fill these in and
# restart the dev server to enable cloud sync across devices.
#
# Where to find them:
#   1. https://console.firebase.google.com  ->  create (or open) a project
#   2. Project settings -> "Your apps" -> Web app -> Config
#   3. Build -> Firestore Database -> Create database
#   4. Build -> Authentication -> Sign-in method -> enable "Email/Password"
#      and "Anonymous"
#
# Copy this file to `.env` (or `.env.local`) and paste your values in.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
