# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in, then restart the dev server.
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------
#
# Everything prefixed VITE_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. That is fine for Firebase web config — it identifies the
# project, it does not authorise anything. Access is controlled by
# firestore.rules, which Firebase enforces server-side.
#
# Never put a service-account key, an admin credential or any private secret
# behind a VITE_ name.
#
# Where to find these:
#   1. https://console.firebase.google.com  ->  create (or open) a project
#   2. Project settings -> "Your apps" -> Web app -> Config
#   3. Build -> Firestore Database -> Create database
#   4. Build -> Authentication -> Sign-in method -> enable "Google" and
#      "Email/Password". Do NOT enable Anonymous — this app refuses accounts
#      without an email address.
#   5. Firestore -> Rules -> paste firestore.rules and Publish.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# There is nothing to configure here. Sign-up is open to anyone with a Google
# account or a confirmed email address, and isolation between accounts is
# enforced entirely by firestore.rules keying on the signed-in uid. There is no
# allowlist in the bundle, because a check shipped to the browser can be edited
# by whoever is holding it and is therefore not a boundary.

# ---------------------------------------------------------------------------
# Analytics — public landing page only, never the tracker
# ---------------------------------------------------------------------------
# Leave BOTH blank (the default) and the site makes zero third-party requests.
#
# Only point this at a cookieless, privacy-first counter — Plausible or Umami,
# hosted or self-hosted. The absence of a consent banner on this site depends on
# nothing being stored on the visitor's device; a provider that sets a cookie or
# an ID in localStorage would legally require one.
#
# Turning this on also means adding the host to script-src and connect-src in
# the CSP block at the top of index.html. It is deliberately not pre-widened.
#
#   VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
#   VITE_ANALYTICS_SITE=your-domain.example

VITE_ANALYTICS_SRC=
VITE_ANALYTICS_SITE=
