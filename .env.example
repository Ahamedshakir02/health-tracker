# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in, then restart the dev server.
# `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------
#
# Everything prefixed VITE_ is inlined into the JavaScript bundle and is
# therefore PUBLIC. That is fine for Firebase web config — it identifies the
# project, it does not authorise anything. Access is controlled by
# firestore.rules, which Firebase enforces server-side.
#
# Never put a service-account key, an admin credential or any private secret
# behind a VITE_ name.
#
# Where to find these:
#   1. https://console.firebase.google.com  ->  create (or open) a project
#   2. Project settings -> "Your apps" -> Web app -> Config
#   3. Build -> Firestore Database -> Create database
#   4. Build -> Authentication -> Sign-in method -> enable "Google" and
#      "Email/Password". Do NOT enable Anonymous — this app refuses accounts
#      without an email address.
#   5. Firestore -> Rules -> paste firestore.rules and Publish.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# The address allowed to sign in. Comma-separate to allow more than one.
# This drives the error message in the UI only — the enforced copy of the same
# list lives in firestore.rules, and both must be changed together.

VITE_ALLOWED_EMAIL=ahamedshakir02@gmail.com
